# Copy to .env (scripts/setup.ps1 does this and fills in random passwords).
WP_PORT=8088
WP_URL=http://localhost:8088
WP_TITLE=John Michael Castillo
WP_DEBUG=1

WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=johnmichaelcastillo.it@gmail.com

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# Public URL of the static site (e.g. https://your-project.vercel.app). Used for canonical,
# og:url and sitemap links, and the contact form's redirect. Required to export the form.
STATIC_URL=

# Web3Forms access key for the static contact form (free at web3forms.com). It ends up in the
# public HTML, which is how Web3Forms is meant to be used.
WEB3FORMS_KEY=
