{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "680px",
			"wideSize": "1120px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Canvas", "color": "#fafafa" },
				{ "slug": "surface", "name": "Surface", "color": "#ffffff" },
				{ "slug": "surface-2", "name": "Surface 2", "color": "#f5f5f5" },
				{ "slug": "line", "name": "Hairline", "color": "#ebebeb" },
				{ "slug": "field", "name": "Field border", "color": "#8f8f8f" },
				{ "slug": "muted", "name": "Muted", "color": "#6b6b6b" },
				{ "slug": "body", "name": "Body", "color": "#4d4d4d" },
				{ "slug": "contrast", "name": "Ink", "color": "#171717" },
				{ "slug": "accent", "name": "Accent", "color": "#2f56d6" },
				{ "slug": "on-accent", "name": "On accent", "color": "#fafafa" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Geist",
					"fontFamily": "Geist, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Geist",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/geist.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Geist Mono",
					"fontFamily": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "Geist Mono",
							"fontStyle": "normal",
							"fontWeight": "400 500",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/geist-mono.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "mono", "name": "Mono", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Body", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Lead", "size": "1.125rem", "fluid": false },
				{ "slug": "h3", "name": "Heading 3", "size": "1.25rem", "fluid": false },
				{ "slug": "x-large", "name": "Heading 2", "size": "clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem)", "fluid": false },
				{ "slug": "xx-large", "name": "Display", "size": "clamp(2.25rem, 1.5rem + 3vw, 3.5rem)", "fluid": false }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "8", "size": "0.5rem" },
				{ "slug": "30", "name": "16", "size": "1rem" },
				{ "slug": "40", "name": "24", "size": "1.5rem" },
				{ "slug": "50", "name": "32–48", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "48–64", "size": "clamp(3rem, 6vw, 4rem)" },
				{ "slug": "70", "name": "56–80", "size": "clamp(3.5rem, 7vw, 5rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 1.5rem)",
				"right": "clamp(1rem, 4vw, 1.5rem)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "fontWeight": "600" }
			},
			"h1": {
				"typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.05", "letterSpacing": "-0.04em" }
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.15", "letterSpacing": "-0.03em" }
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--h3)", "lineHeight": "1.3", "letterSpacing": "-0.015em" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--on-accent)"
				},
				"border": { "radius": "6px" },
				"spacing": {
					"padding": { "top": "0.625rem", "bottom": "0.625rem", "left": "1.125rem", "right": "1.125rem" }
				},
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500", "lineHeight": "1.4" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "600", "letterSpacing": "-0.01em" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--contrast)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500" },
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--mono)"
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
