{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "640px",
			"wideSize": "880px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Paper", "color": "#f9f8f6" },
				{ "slug": "surface", "name": "Surface", "color": "#ffffff" },
				{ "slug": "surface-2", "name": "Surface 2", "color": "#f1efeb" },
				{ "slug": "line", "name": "Hairline", "color": "#e6e3de" },
				{ "slug": "field", "name": "Field border", "color": "#a8a29b" },
				{ "slug": "muted", "name": "Muted", "color": "#736d66" },
				{ "slug": "body", "name": "Body", "color": "#3d3a36" },
				{ "slug": "contrast", "name": "Ink", "color": "#181715" },
				{ "slug": "accent", "name": "Accent", "color": "#c2410c" },
				{ "slug": "on-accent", "name": "On accent", "color": "#fdfcfb" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Schibsted Grotesk",
					"fontFamily": "\"Schibsted Grotesk\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Schibsted Grotesk",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/schibsted-grotesk.woff2" ]
						},
						{
							"fontFamily": "Schibsted Grotesk",
							"fontStyle": "italic",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/schibsted-grotesk-italic.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "IBM Plex Mono",
					"fontFamily": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-mono.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "mono", "name": "Mono", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Body", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.125rem", "fluid": false },
				{ "slug": "h3", "name": "Heading 3", "size": "1rem", "fluid": false },
				{ "slug": "x-large", "name": "Heading", "size": "1.5rem", "fluid": false },
				{ "slug": "xx-large", "name": "Intro", "size": "clamp(1.5rem, 1.1rem + 1.6vw, 2.125rem)", "fluid": false }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "8", "size": "0.5rem" },
				{ "slug": "30", "name": "16", "size": "1rem" },
				{ "slug": "40", "name": "24", "size": "1.5rem" },
				{ "slug": "50", "name": "32", "size": "2rem" },
				{ "slug": "60", "name": "48", "size": "clamp(2.5rem, 5vw, 3rem)" },
				{ "slug": "70", "name": "64–88", "size": "clamp(3.5rem, 8vw, 5.5rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1rem",
			"padding": {
				"left": "clamp(1.25rem, 5vw, 2rem)",
				"right": "clamp(1.25rem, 5vw, 2rem)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "textDecoration": "underline" }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "fontWeight": "600", "letterSpacing": "-0.01em" }
			},
			"h1": {
				"typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "500", "lineHeight": "1.28", "letterSpacing": "-0.025em" }
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.25", "letterSpacing": "-0.02em" }
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--h3)", "lineHeight": "1.4" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "8px" },
				"spacing": {
					"padding": { "top": "0.6rem", "bottom": "0.6rem", "left": "1rem", "right": "1rem" }
				},
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "500", "lineHeight": "1.4" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "600", "letterSpacing": "-0.01em" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--contrast)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/post-date": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--mono)"
				},
				"color": { "text": "var(--wp--preset--color--muted)" }
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--mono)"
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
