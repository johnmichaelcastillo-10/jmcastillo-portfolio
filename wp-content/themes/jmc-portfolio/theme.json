{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Background (#FAFAFA)", "color": "#fafafa" },
				{ "slug": "surface", "name": "Surface", "color": "#ffffff" },
				{ "slug": "surface-2", "name": "Surface 2", "color": "#f4f4f5" },
				{ "slug": "line", "name": "Border", "color": "#e4e4e7" },
				{ "slug": "field", "name": "Field border (#A1A1AA)", "color": "#a1a1aa" },
				{ "slug": "muted", "name": "Muted text", "color": "#71717a" },
				{ "slug": "body", "name": "Text (#3F3F46)", "color": "#3f3f46" },
				{ "slug": "contrast", "name": "Ink (#09090B)", "color": "#09090b" },
				{ "slug": "primary", "name": "Primary (#18181B)", "color": "#18181b" },
				{ "slug": "primary-soft", "name": "Primary soft", "color": "#f4f4f5" },
				{ "slug": "on-primary", "name": "On primary", "color": "#fafafa" },
				{ "slug": "accent", "name": "Accent (#18181B)", "color": "#18181b" },
				{ "slug": "accent-soft", "name": "Accent soft", "color": "#f4f4f5" },
				{ "slug": "success", "name": "Success", "color": "#15803d" },
				{ "slug": "warning", "name": "Warning", "color": "#a15c07" },
				{ "slug": "error", "name": "Error", "color": "#b42318" },
				{ "slug": "info", "name": "Info", "color": "#3f3f46" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Schibsted Grotesk",
					"fontFamily": "\"Schibsted Grotesk\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Schibsted Grotesk",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/schibsted-grotesk.woff2" ]
						},
						{
							"fontFamily": "Schibsted Grotesk",
							"fontStyle": "italic",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/schibsted-grotesk-italic.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "IBM Plex Mono",
					"fontFamily": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "IBM Plex Mono",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/ibm-plex-mono.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "xs", "name": "Extra small", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Body", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Lead", "size": "1.1875rem", "fluid": false },
				{ "slug": "h3", "name": "Heading 3", "size": "1.25rem", "fluid": false },
				{ "slug": "x-large", "name": "Heading 2", "size": "clamp(1.875rem, 1.35rem + 1.9vw, 2.75rem)", "fluid": false },
				{ "slug": "xx-large", "name": "Display", "size": "clamp(2.5rem, 1.5rem + 3.9vw, 4.5rem)", "fluid": false }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "2xs", "size": "0.5rem" },
				{ "slug": "30", "name": "xs", "size": "1rem" },
				{ "slug": "40", "name": "s", "size": "1.5rem" },
				{ "slug": "50", "name": "m", "size": "clamp(2rem, 3.5vw, 2.5rem)" },
				{ "slug": "60", "name": "l", "size": "clamp(2.5rem, 5vw, 3.5rem)" },
				{ "slug": "70", "name": "xl", "size": "clamp(4.5rem, 9vw, 7.5rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1rem",
			"padding": {
				"left": "clamp(1.25rem, 5vw, 2.5rem)",
				"right": "clamp(1.25rem, 5vw, 2.5rem)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "textDecoration": "underline" }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "fontWeight": "650", "letterSpacing": "-0.02em" }
			},
			"h1": {
				"typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "650", "lineHeight": "1.04", "letterSpacing": "-0.035em" }
			},
			"h2": {
				"typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.12", "letterSpacing": "-0.03em" }
			},
			"h3": {
				"typography": { "fontSize": "var(--wp--preset--font-size--h3)", "lineHeight": "1.3", "letterSpacing": "-0.015em" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--on-primary)"
				},
				"border": { "radius": "10px" },
				"spacing": {
					"padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.25rem", "right": "1.25rem" }
				},
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "600", "lineHeight": "1.25" }
			}
		},
		"blocks": {
			"core/post-date": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--xs)"
				},
				"color": { "text": "var(--wp--preset--color--muted)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
